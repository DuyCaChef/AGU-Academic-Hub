# --- BẢO MẬT PII & FILE TẢI LÊN (AGU ACADEMIC HUB SPEC) ---
# Chặn hoàn toàn việc commit file tài liệu học thuật và ảnh thẻ KYC
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/private/kyc/*
!/storage/app/private/kyc/.gitignore